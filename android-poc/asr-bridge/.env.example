# 所有值留空。填入完整三项后才会启用真实腾讯云 ASR；
# 三项都不填时服务端自动进入 mock 模式（每条事件带 mock:true）。
# 只填一部分会在启动时明确报错，不会静默降级。

# 腾讯云语音识别控制台 -> API 密钥管理
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 可选：留空则使用代码默认值
# 双轨英文引擎默认 16k_en
TENCENT_ENGINE_EN=
# 混音说话人分离引擎默认 16k_zh_en_speaker_2.0
TENCENT_ENGINE_SPEAKER=

# 可选：留空则使用 127.0.0.1:8790
HOST=
PORT=

# 可选：设为 1 时即使填了密钥也强制 mock，便于本地联调
ASR_FORCE_MOCK=
