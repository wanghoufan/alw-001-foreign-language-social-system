# ---------------------------------------------------------------------------
# ALW-001 V1.7 R2 C4 · 云端薄网关环境变量模板
#
# 只列变量名与含义，不含任何真实值。复制为 .env 后再填写。
# 所有预算默认 0：未填写预算前，任何付费请求都会返回 402。
# ---------------------------------------------------------------------------

# 服务监听
PORT=8783
HOST=127.0.0.1

# 状态存储：sqlite（默认，本地可用）或 redis（生产可选，未实测）
CLOUD_STATE_DRIVER=sqlite
# SQLite 文件路径；相对路径按启动目录解析。生产请用绝对路径。
CLOUD_STATE_DB=<项目内可写路径，例如 /srv/alw001/state/cloud-gateway.db>
# Redis 连接串（CLOUD_STATE_DRIVER=redis 时必填）
CLOUD_REDIS_URL=<redis://用户名:密码@主机:端口/库号>

# 安全：令牌签名主密钥（至少 32 字符）与服务端管理令牌
CLOUD_GATEWAY_TOKEN_SECRET=<至少 32 字符的随机字符串>
CLOUD_GATEWAY_ADMIN_TOKEN=<只用于签发/撤销设备令牌的管理令牌>

# 限流与幂等
CLOUD_RATE_LIMIT_PER_WINDOW=30
CLOUD_RATE_WINDOW_MS=60000
CLOUD_IDEMPOTENCY_TTL_MS=86400000
CLOUD_TTS_REQUIRE_CONSENT=true

# DeepSeek
DEEPSEEK_API_KEY=<DeepSeek API Key>
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
CLOUD_DEEPSEEK_BUDGET_CNY=0
DEEPSEEK_INPUT_PRICE_CNY_PER_MILLION=2
DEEPSEEK_OUTPUT_PRICE_CNY_PER_MILLION=8

# 豆包语音合成 2.0
SM_DOUBAO_API_KEY=<豆包语音 API Key>
SM_DOUBAO_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
SM_DOUBAO_RESOURCE_ID=seed-tts-2.0
CLOUD_TTS_BUDGET_CNY=0
DOUBAO_PRICE_CNY_PER_1000_CHARS=0.3

# ASR 上游：tencent 直连或 p066 中继
CLOUD_ASR_UPSTREAM=tencent
TENCENT_APP_ID=<腾讯云 AppId（纯数字）>
TENCENT_SECRET_ID=<腾讯云 SecretId>
TENCENT_SECRET_KEY=<腾讯云 SecretKey>
TENCENT_ENGINE_EN=16k_en
TENCENT_ENGINE_SPEAKER=16k_zh_en_speaker_2.0

# P066 中继（CLOUD_ASR_UPSTREAM=p066 时使用）
CLOUD_ASR_P066_URL=<ws:// 或 wss:// 地址>
CLOUD_ASR_P066_TOKEN=<P066 访问令牌>
CLOUD_ASR_P066_ENGINE=16k_zh_en_speaker_2.0

# ASR 预算与上限
CLOUD_ASR_BUDGET_CNY=0
CLOUD_ASR_P066_BUDGET_CNY=0
TENCENT_ASR_PRICE_CNY_PER_HOUR=1
CLOUD_ASR_MAX_SESSION_SECONDS=300
CLOUD_ASR_MAX_CONCURRENT_PER_DEVICE=2